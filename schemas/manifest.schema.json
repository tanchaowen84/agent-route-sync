{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest v1",
  "type": "object",
  "required": ["schema_version", "scope", "generated_at_utc", "files", "source_versions", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "scope": {"const": "domestic_direct_and_adblock"},
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "datasets": {"type": "array", "minItems": 5, "maxItems": 5},
    "order": {"type": "array", "items": {"type": "string"}},
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$",
        "not": {"const": "manifest.json"}
      },
      "additionalProperties": {"$ref": "#/$defs/digest"}
    },
    "source_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/digest"}},
    "source_versions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
          "committed_at": {"type": "string", "format": "date-time"},
          "url": {"type": "string", "format": "uri"}
        }
      }
    },
    "sources": {"type": "object", "additionalProperties": {"type": "string", "format": "uri"}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
